<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FocusFlow" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/focusflow_indigo</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <!--
      Launcher theme
      The launcher is dark and draws its own wallpaper edge to edge, so the system bars must not
      add their own light strip. Without this, three-button navigation shows a translucent white
      bar behind the buttons because the app theme is a light theme.
    -->
    <style name="Theme.FocusFlow.Launcher" parent="Theme.FocusFlow">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:navigationBarDividerColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
    </style>

    <!--
      Native Splash Theme
      Mirrors archived Expo splash configuration:
      backgroundColor: #6366f1, resizeMode: contain, image: splash.png
      Prevents white or black flash on cold launch before Compose initializes.
    -->
    <style name="Theme.FocusFlow.Splash" parent="Theme.FocusFlow">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:statusBarColor">@color/focusflow_indigo</item>
        <item name="android:navigationBarColor">@color/focusflow_indigo</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>