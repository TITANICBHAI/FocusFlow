modules = ["web", "nodejs-20", "bash"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Push to GitHub"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Run Android UI verification"

[[workflows.workflow]]
name = "Push to GitHub"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node scripts/github-push.mjs"

[[workflows.workflow]]
name = "Run Android unit tests"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/test-unit.sh"

[[workflows.workflow]]
name = "Run Android UI verification"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/android-ui-verification.sh"

[workflows.workflow.metadata]
outputType = "vnc"

[[ports]]
localPort = 22876
externalPort = 80
